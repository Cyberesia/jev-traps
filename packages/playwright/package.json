    "@types/node": "22.20.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyberesia/jev-traps.git",
    "directory": "packages/playwright"
  },
  "homepage": "https://github.com/cyberesia/jev-traps#readme",
  "bugs": {
    "url": "https://github.com/cyberesia/jev-traps/issues"
