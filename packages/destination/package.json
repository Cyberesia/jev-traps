{
  "name": "@jev-traps/destination",
  "version": "0.1.0",
  "description": "Local destination intelligence and preflight policy for Jev Traps.",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./urlhaus": {
      "types": "./dist/urlhaus.d.ts",
      "import": "./dist/urlhaus.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
