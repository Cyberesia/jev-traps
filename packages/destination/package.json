  },
  "engines": {
    "node": ">=22.15.0"
  },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyberesia/jev-traps.git",
    "directory": "packages/destination"
