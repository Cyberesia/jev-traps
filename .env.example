# Required only for live Jev semantic classification
TYPESAFE_API_KEY=

# Private intake queue (visitor reports). Production uses Postgres
# (Neon or any standard Postgres). Apply apps/registry/db/migrations/001_submissions.sql first.
DATABASE_URL=

# Local development fallback when no DATABASE_URL is set: JSONL file path.
# Single-host only, never for serverless production.
REGISTRY_DATA_FILE=

# Production private intake is off unless explicitly enabled.
REGISTRY_ENABLE_SUBMISSIONS=0

# Anti-abuse for the public report form (Cloudflare Turnstile).
# Required in production when intake is enabled.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Maximum visitor reports accepted per 24h (default 200).
REGISTRY_DAILY_CAP=200

# Automated observations received privately from configured agent SDKs.
# Generate a high-entropy server-side key and use the same value as
# JEV_TRAPS_REGISTRY_KEY in trusted SDK host processes.
REGISTRY_ENABLE_OBSERVATIONS=0
REGISTRY_INGEST_KEY=

# Optional SDK host: same secret as REGISTRY_INGEST_KEY on the Registry deployment.
JEV_TRAPS_REGISTRY_ENDPOINT=
JEV_TRAPS_REGISTRY_KEY=
# Optional agent-host destination preflight. The host must refresh this private snapshot.
JEV_TRAPS_DESTINATION_SNAPSHOT=
JEV_TRAPS_DESTINATION_JEV=0

# Optional, only for explicit live image inspection / benchmarks.
VISION_PROVIDER=anthropic
VISION_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Open-weight server (vision-capable OpenAI-compatible API only)
VISION_BASE_URL=http://127.0.0.1:8000/v1
VISION_API_KEY=

# Separate consent for a public, explicitly unverified feed (default: private).
# Keeping this off preserves reviewed registry.json as the public evidence source.
REGISTRY_PUBLIC_OBSERVATIONS=0

# URL-first website scans. Production requires an isolated worker, quota DB and Turnstile.
REGISTRY_ENABLE_URL_SCAN=0
SCAN_WORKER_URL=https://your-scan-service.example/scan
SCAN_WORKER_KEY=
REGISTRY_SCAN_JEV=0
REGISTRY_SCAN_DESTINATION_JEV=0
REGISTRY_SCAN_DAILY_CAP=100
# Worker host only (never NEXT_PUBLIC):
# EGRESS_KEY, TYPESAFE_API_KEY, ENABLE_JEV=1, ENABLE_DESTINATION_JEV=1
# Optional maintained malware-distribution feed. Obtain an Auth-Key from auth.abuse.ch;
# provider terms and fair-use limits apply. The key is never stored in the local snapshot.
URLHAUS_AUTH_KEY=
# Keep blank for the official active CSV endpoint. Override only for a compatible trusted service.
URLHAUS_EXPORT_URL=
DESTINATION_REFRESH_MS=600000
DESTINATION_HOSTNAME_REVIEW=1
