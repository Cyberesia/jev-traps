# Required only for live Jev semantic classification
TYPESAFE_API_KEY=

# Optional registry write target for local/self-hosted deployments.
# Defaults to apps/registry/data/submissions.local.json
REGISTRY_DATA_FILE=

# Production private intake is off unless explicitly enabled.
REGISTRY_ENABLE_SUBMISSIONS=0

# Optional, only for explicit live image inspection / benchmarks.
VISION_PROVIDER=anthropic
VISION_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Open-weight server (vision-capable OpenAI-compatible API only)
VISION_BASE_URL=http://127.0.0.1:8000/v1
VISION_API_KEY=
